# ═══════════════════════════════════════════════════════════════
# Environment — Architect Platform
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# ── Domain ─────────────────────────────────────────────────────
DOMAIN=dunaev.dev

# ── Backend ────────────────────────────────────────────────────
PORT=8080
DB_PATH=/data/architect.db
CORS_ORIGIN=https://${DOMAIN}

# ── PostgreSQL (optional, only if using 'full' or 'db' profile) ─
PG_DB=architect
PG_USER=architect
PG_PASSWORD=changeme

# ── ComfyUI (optional) ─────────────────────────────────────────
# COMFYUI_PORT=8188
# COMFYUI_DIR=/home/i/comfy/ComfyUI

# ── Monitoring ─────────────────────────────────────────────────
# UPTIME_MONITOR_URL=https://${DOMAIN}
# ALERT_WEBHOOK_URL=  # Slack/Telegram webhook

# ── Backup ─────────────────────────────────────────────────────
# BACKUP_ROOT=/var/backups
# BACKUP_RETENTION_DAYS=30
