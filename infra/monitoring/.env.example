# ═══════════════════════════════════════════════════════════════
# Environment config — dunaev.dev monitoring & backups
# ═══════════════════════════════════════════════════════════════
#
# Copy to .env and fill in secrets:
#   cp monitoring/.env.example monitoring/.env
#   vi monitoring/.env

# ── Domain ────────────────────────────────────────────────────
DOMAIN=https://dunaev.dev

# ── Telegram alerts ───────────────────────────────────────────
# Create bot: https://t.me/BotFather
# Get chat ID: send /start to your bot, then:
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Resource thresholds ───────────────────────────────────────
CPU_WARN=80
CPU_CRIT=95
RAM_WARN=80
RAM_CRIT=95
DISK_WARN=80
DISK_CRIT=92
LOAD_WARN=4.0
LOAD_CRIT=8.0

# ── Webhook (alternative alert channel) ───────────────────────
# Leave empty to disable
WEBHOOK_URL=

# ── S3 / R2 backup storage ────────────────────────────────────
# Sign up: Cloudflare R2 (free 10GB) or your own S3-compatible
S3_ENDPOINT=
S3_BUCKET=dunaev-backups
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database credentials (override defaults) ──────────────────
PG_DB=architect
PG_USER=architect
PG_PASSWORD=changeme
